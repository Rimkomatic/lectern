# Save this file as `.env` next to docker-compose.yml and edit it. (In a clone
# of the repository:   cp .env.example .env)
#
# `docker compose` reads .env for both containers (the app and MySQL), so every
# value is written once. Real environment variables always win over the file.
#
# Rules: keep comments on their own lines, and wrap a value in single quotes
# if it contains `$` or `#`, for example MYSQL_PASSWORD='pa$word#1'

# ---- Set these three ---------------------------------------------------------

# Passwords. Choose your own. The app logs in with MYSQL_PASSWORD only; the root
# password is just for MySQL itself. Set them before the first start: MySQL
# keeps the password it was created with (changing them later means changing
# them inside MySQL as well). Avoid ' and \ in them: the MySQL image writes the
# password into an SQL statement as it is.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me

# The folder with your courses, on the machine that runs Docker. It is mounted
# read-only, so Lectern can never change your files. Every folder inside it is a
# course. Put the path in quotes if it has spaces.
LECTERN_LIBRARY=/path/to/your/courses

# ---- Usually fine as they are --------------------------------------------------

# The port the site answers on: http://<this machine>:8080
LECTERN_PORT=8080

# Which version to run: latest (the newest release), a version such as 1.2.3 or
# 1.2 to stay on it, or edge (every change on the main branch; it can break).
# Update with: docker compose pull && docker compose up -d
#LECTERN_TAG=latest

# Who the app runs as inside its container. That user has to be allowed to read
# your files. Run `id -u` and `id -g` on the server; 1000 is the usual answer.
PUID=1000
PGID=1000

# Names of the database and its user (created on the first start).
MYSQL_DATABASE=lectern
MYSQL_USER=lectern

# ---- Optional: everything below shows the default ----------------------------

# Create the first administrator at start-up (only if there are no users yet)
# instead of using the setup page. Remove the password from the file afterwards.
#LECTERN_ADMIN_USER=
#LECTERN_ADMIN_PASSWORD=

# How often to look for changed files. 0 means only at start-up and when an
# admin presses "Scan now".
#LECTERN_SCAN_INTERVAL=15m

# How long to keep progress for files that vanished (a drive that was not
# mounted, a renamed folder) before forgetting it. Accepts s, m, h and d.
#LECTERN_MISSING_RETENTION=30d

# How long a login lasts after the last visit.
#LECTERN_SESSION_TTL=30d

# Share of a video or audio file that counts as watched (0.5 to 1).
#LECTERN_DONE_THRESHOLD=0.95

# Follow symbolic links that point outside the library folders. (In Docker they
# also have to point to something that is mounted into the container.)
#LECTERN_FOLLOW_SYMLINKS=false

# Behind a reverse proxy (Caddy, nginx, Traefik): set LECTERN_TRUST_PROXY to
# true so the app believes X-Forwarded-Proto and X-Forwarded-For. The login
# cookie is marked Secure automatically over HTTPS (auto); force it with
# true or false.
#LECTERN_TRUST_PROXY=false
#LECTERN_COOKIE_SECURE=auto

# Extra origins allowed to send logins and other changes, comma separated, for
# when the site is reached under a name the app cannot see, for example
# http://lectern.lan:8080
#LECTERN_ALLOWED_ORIGINS=

# debug, info, warn or error.
#LECTERN_LOG_LEVEL=info

# How long to wait for MySQL at start-up (it can take a while on first boot).
#LECTERN_DB_WAIT=60s

# A complete go-sql-driver DSN, if you need options the fields above cannot
# express (for example a MySQL server elsewhere, with TLS). It replaces the
# MYSQL_* connection settings. See "Your own MySQL" in the README.
#LECTERN_DB_DSN=

# ---- Only when you run the app from source (make run), not in Docker ---------

# `make run` reads this same file. It finds MySQL on 127.0.0.1 (published by
# `make db`) and needs to know where your courses are. The container ignores
# these two lines.
#MYSQL_PORT=3306
#LECTERN_LIBRARIES=/path/to/your/courses
